    {
      "id": "code_handoff",
      "lane": "build",
      "col": 5,
      "type": "cloud",
      "label": "code-handoff",
      "sublabel": "commit, push, PR",
      "width": 118
    },
    {
      "id": "pr_fix",
      "lane": "after",
      "col": 4,
      "type": "backend",
      "label": "pr-fix",
      "sublabel": "comments, red CI"
    },
    {
      "id": "qa",
      "lane": "after",
      "col": 5,
      "type": "security",
      "label": "qa",
      "sublabel": "a video per AC"
    }
  ],
  "edges": [
    {
      "from": "init",
      "to": "product_discovery"
    },
    {
      "from": "product_discovery",
      "to": "product_mvp_cut",
      "label": "prd.md"
    },
    {
      "from": "product_mvp_cut",
      "to": "design_system",
      "label": "mvp.md"
    },
    {
      "from": "design_system",
      "to": "task_create"
    },
    {
      "from": "task_create",
      "to": "task_next",
      "label": "tickets"
    },
    {
      "from": "task_next",
      "to": "sync_before",
      "label": "next ticket",
      "variant": "emphasis"
    },
    {
      "from": "sync_before",
      "to": "code_plan"
    },
    {
      "from": "code_plan",
      "to": "code_implement",
      "label": "plan"
    },
    {
      "from": "code_implement",
      "to": "code_review"
    },
    {
      "from": "code_review",
      "to": "sync_after",
      "label": "approved"
    },
    {
      "from": "sync_after",
      "to": "code_handoff"
    },
    {
      "from": "code_handoff",
      "to": "qa",
      "label": "open PR",
      "variant": "emphasis"
    },
    {
      "from": "code_review",
      "to": "code_implement",
      "label": "must fix",
      "variant": "dashed",
      "role": "return"
    },
    {
      "from": "code_handoff",
      "to": "pr_fix",
      "label": "review feedback",
      "role": "branch"
    },
    {
      "from": "pr_fix",
      "to": "code_handoff",
      "label": "fixes",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "You decide",
      "items": [
        "The product skills interview you",
        "Tickets publish only if the repo allows it",
        "Scope and security blockers return to you"
      ]
    },
    {
      "dot": "emerald",
      "title": "It runs on its own",
      "items": [
        "/shipit:run <ID> chains the build stages",
        "Needs a tracker and a clean tree",
        "Ends at a PR ready for human QA"
      ]
    },
    {
      "dot": "amber",
      "title": "Around the flow",
      "items": [
        "init asks the tracker only in an empty repo",
        "task-next never starts the work",
        "doctor, status and retro only report"
      ]
    }
  ]
}
