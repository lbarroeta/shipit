{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "shipit: from idea to pull request",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "Interviews you"
        },
        "database": {
          "label": "Repo contract (.shipit/)"
        },
        "messagebus": {
          "label": "Tracker tickets"
        },
        "backend": {
          "label": "Plans or writes code"
        },
        "security": {
          "label": "Checks the work"
        },
        "cloud": {
          "label": "Delivers (git, PR)"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "plan",
      "label": "Plan: decided with you, then turned into tickets"
    },
    {
      "id": "build",
      "label": "Build: one ticket at a time"
    },
    {
      "id": "after",
      "label": "After the pull request"
    }
  ],
  "groups": [
    {
      "id": "run_chain",
      "label": "/shipit:run chains these six",
      "lane": "build",
      "fromCol": 0,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "sync_before",
    "code_plan",
    "code_implement",
    "code_review",
    "sync_after",
    "code_handoff",
    "qa"
  ],
  "nodes": [
    {
      "id": "init",
      "lane": "plan",
      "col": 0,
      "type": "database",
      "label": "init",
      "sublabel": "reads the repo"
    },
    {
      "id": "product_discovery",
      "lane": "plan",
      "col": 1,
      "type": "frontend",
      "label": "product-discovery",
      "sublabel": "idea to PRD",
      "width": 152
    },
    {
      "id": "product_mvp_cut",
      "lane": "plan",
      "col": 2,
      "type": "frontend",
      "label": "product-mvp-cut",
      "sublabel": "what ships first",
      "width": 138
    },
    {
      "id": "design_system",
      "lane": "plan",
      "col": 3,
      "type": "frontend",
      "label": "design-system",
      "sublabel": "repos with UI",
      "width": 124
    },
    {
      "id": "task_create",
      "lane": "plan",
      "col": 4,
      "type": "messagebus",
      "label": "task-create",
      "sublabel": "or task-import",
      "width": 111
    },
    {
      "id": "task_next",
      "lane": "plan",
      "col": 5,
      "type": "messagebus",
      "label": "task-next",
      "sublabel": "recommends only",
      "width": 97
    },
    {
      "id": "sync_before",
      "lane": "build",
      "col": 0,
      "type": "database",
      "label": "sync",
      "sublabel": "before planning"
    },
    {
      "id": "code_plan",
      "lane": "build",
      "col": 1,
      "type": "backend",
      "label": "code-plan",
      "sublabel": "the contract",
      "width": 97
    },
    {
      "id": "code_implement",
      "lane": "build",
      "col": 2,
      "type": "backend",
      "label": "code-implement",
      "sublabel": "code + checks",
      "width": 131
    },
    {
      "id": "code_review",
      "lane": "build",
      "col": 3,
      "type": "security",
      "label": "code-review",
      "sublabel": "read-only",
      "width": 111
    },
    {
      "id": "sync_after",
      "lane": "build",
      "col": 4,
      "type": "database",
      "label": "sync",
      "sublabel": "after the change"
